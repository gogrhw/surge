#!name=Spotify Unlock
#!author=gogrhw
#!category=Philalethia
#!desc=Unlock Spotify Premium features by rewriting account attributes and selected client API requests.

[Script]
spotify-header = type=http-request, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$, script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/spotify-header.js, timeout=60

spotify-proto = type=http-response, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$, script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/spotify-proto.js, requires-body=true, binary-body-mode=true, max-size=-1, timeout=60

spotify-json = type=http-request, pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/, script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/spotify-json.js, timeout=60

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com
