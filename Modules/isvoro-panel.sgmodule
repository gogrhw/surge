#!name=ISVORO Panel
#!author=gogrhw
#!category=Philalethia
#!desc=Read-only Surge panels for ISVORO balance, server status, remaining traffic, and expiry alerts. Servers that need attention appear first. Optional detail panels cover all 14 read endpoints.
#!arguments=API_KEY:YOUR_API_KEY,SCRIPT_PATH:auto,UPDATE_INTERVAL:600,SERVER_ID:NONE,PRODUCT_ID:NONE,INVOICE_ID:NONE,PAGE:1,PER_PAGE:5,MAX_ROWS:5,SERVER_STATUS:NONE,SERVER_QUERY:NONE,INVOICE_STATUS:NONE,TIMEFRAME:hour,TRAFFIC_DAYS:30,SHOW_DETAILS:false,SHOW_ACCOUNT:true,SHOW_PRODUCTS:true,SHOW_SERVERS:true,SHOW_LIVE:true,SHOW_TRAFFIC:true,SHOW_STORAGE:true,SHOW_BILLING:true
#!arguments-desc=- API_KEY: ISVORO Open API key with read scope (isv_ prefix).\n- SCRIPT_PATH: auto uses this repository's remote script. Accepts a custom URL or an absolute local path.\n- UPDATE_INTERVAL: refresh interval in seconds.\n- SERVER_ID: NONE shows all servers in the overview. An ID selects one server and supplies detail queries.\n- PRODUCT_ID / INVOICE_ID: NONE shows a list. An ID selects a single item.\n- PAGE: page number for detail lists.\n- PER_PAGE: items per page for detail lists, [1-100].\n- MAX_ROWS: servers in the overview or rows per detail group, [1-100]. Totals include all fetched data.\n- SERVER_STATUS / INVOICE_STATUS: status filters for detail lists. NONE disables filtering.\n- SERVER_QUERY: server search for detail lists. NONE disables search. URL-encode special characters.\n- TIMEFRAME: historical metrics window, [hour, day, week, month, year].\n- TRAFFIC_DAYS: daily traffic history, [30, 60, 90].\n- SHOW_DETAILS: enable optional detail panels, [true, false]. Disabled by default.\n- SHOW_ACCOUNT / SHOW_PRODUCTS / SHOW_SERVERS / SHOW_LIVE / SHOW_TRAFFIC / SHOW_STORAGE / SHOW_BILLING: select detail panels, [true, false]. Requires SHOW_DETAILS=true.\n\nOnly the overview is shown by default. Set API_KEY to get started. Live, Traffic, and Storage panels also require SERVER_ID.
#!requirement=CORE_VERSION>=22

[Panel]
ISVORO Overview = title="ISVORO",content="Waiting for refresh",script-name=isvoro-overview,update-interval={{{UPDATE_INTERVAL}}}
ISVORO Account = title="ISVORO / Account",content="Waiting for refresh",script-name=isvoro-account,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_ACCOUNT}}}' == 'true'"
ISVORO Products = title="ISVORO / Products",content="Waiting for refresh",script-name=isvoro-products,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_PRODUCTS}}}' == 'true'"
ISVORO Servers = title="ISVORO / Servers",content="Waiting for refresh",script-name=isvoro-servers,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_SERVERS}}}' == 'true'"
ISVORO Live = title="ISVORO / Live",content="Set SERVER_ID and refresh",script-name=isvoro-live,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_LIVE}}}' == 'true'"
ISVORO Traffic = title="ISVORO / Traffic",content="Set SERVER_ID and refresh",script-name=isvoro-traffic,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_TRAFFIC}}}' == 'true'"
ISVORO Storage = title="ISVORO / Storage",content="Set SERVER_ID and refresh",script-name=isvoro-storage,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_STORAGE}}}' == 'true'"
ISVORO Billing = title="ISVORO / Billing",content="Waiting for refresh",script-name=isvoro-billing,update-interval={{{UPDATE_INTERVAL}}} #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_BILLING}}}' == 'true'"

[Script]
isvoro-overview = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=overview&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-overview = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=overview&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-account = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=account&api_key={{{API_KEY}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_ACCOUNT}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-account = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=account&api_key={{{API_KEY}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_ACCOUNT}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-products = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=products&api_key={{{API_KEY}}}&product_id={{{PRODUCT_ID}}}&page={{{PAGE}}}&per_page={{{PER_PAGE}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_PRODUCTS}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-products = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=products&api_key={{{API_KEY}}}&product_id={{{PRODUCT_ID}}}&page={{{PAGE}}}&per_page={{{PER_PAGE}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_PRODUCTS}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-servers = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=servers&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&page={{{PAGE}}}&per_page={{{PER_PAGE}}}&max_rows={{{MAX_ROWS}}}&status={{{SERVER_STATUS}}}&q={{{SERVER_QUERY}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_SERVERS}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-servers = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=servers&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&page={{{PAGE}}}&per_page={{{PER_PAGE}}}&max_rows={{{MAX_ROWS}}}&status={{{SERVER_STATUS}}}&q={{{SERVER_QUERY}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_SERVERS}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-live = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=live&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&timeframe={{{TIMEFRAME}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_LIVE}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-live = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=live&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&timeframe={{{TIMEFRAME}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_LIVE}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-traffic = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=traffic&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&days={{{TRAFFIC_DAYS}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_TRAFFIC}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-traffic = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=traffic&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&days={{{TRAFFIC_DAYS}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_TRAFFIC}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-storage = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=storage&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_STORAGE}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-storage = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=storage&api_key={{{API_KEY}}}&server_id={{{SERVER_ID}}}&max_rows={{{MAX_ROWS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_STORAGE}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
isvoro-billing = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/isvoro-panel.js,argument="mode=billing&api_key={{{API_KEY}}}&invoice_id={{{INVOICE_ID}}}&page={{{PAGE}}}&per_page={{{PER_PAGE}}}&max_rows={{{MAX_ROWS}}}&status={{{INVOICE_STATUS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_BILLING}}}' == 'true' && '{{{SCRIPT_PATH}}}' == 'auto'"
isvoro-billing = type=generic,timeout=20,script-path={{{SCRIPT_PATH}}},argument="mode=billing&api_key={{{API_KEY}}}&invoice_id={{{INVOICE_ID}}}&page={{{PAGE}}}&per_page={{{PER_PAGE}}}&max_rows={{{MAX_ROWS}}}&status={{{INVOICE_STATUS}}}" #!REQUIREMENT "'{{{SHOW_DETAILS}}}' == 'true' && '{{{SHOW_BILLING}}}' == 'true' && '{{{SCRIPT_PATH}}}' != 'auto'"
