#!name=KiwiVM Panel
#!author=gogrhw
#!category=Philalethia
#!desc=Read-only Surge information panels for KiwiVM/BandwagonHost status, traffic, network, snapshots, backups, security, and maintenance.
#!arguments=Panel Title:KiwiVM,Update Interval:600,Panel Icon:server.rack,Panel Color:6F4A35,Show Overview:true,Show Live:true,Show Network:true,Show Storage:true,Show Security:true,Show Maintenance:true,VEID:YOUR_VEID,API Key:YOUR_API_KEY
#!arguments-desc=- Panel Title: display title for the panel group.\n- Update Interval: refresh interval in seconds.\n- Panel Icon: SF Symbols icon name.\n- Panel Color: hex color without leading #.\n- Show Overview: show the overview panel, [true, false].\n- Show Live: show the live status panel, [true, false].\n- Show Network: show the network panel, [true, false].\n- Show Storage: show the snapshots and backups panel, [true, false].\n- Show Security: show the security panel, [true, false].\n- Show Maintenance: show the maintenance panel, [true, false].\n- VEID: your BandwagonHost VPS ID.\n- API Key: KiwiVM API key from the control panel.\n\nAll panels are read-only. This module does not expose restart, stop, reinstall, shell, snapshot restore, or other VPS operation calls.
#!requirement=CORE_VERSION>=22

[Panel]
KiwiVM Overview = title="{{{Panel Title}}} / Overview",content="Waiting for refresh",icon="{{{Panel Icon}}}",script-name=kiwivm-overview,update-interval={{{Update Interval}}} #!REQUIREMENT "'{{{Show Overview}}}' == 'true'"
KiwiVM Live = title="{{{Panel Title}}} / Live",content="Waiting for refresh",icon="waveform.path.ecg",script-name=kiwivm-live,update-interval={{{Update Interval}}} #!REQUIREMENT "'{{{Show Live}}}' == 'true'"
KiwiVM Network = title="{{{Panel Title}}} / Network",content="Waiting for refresh",icon="network",script-name=kiwivm-network,update-interval={{{Update Interval}}} #!REQUIREMENT "'{{{Show Network}}}' == 'true'"
KiwiVM Storage = title="{{{Panel Title}}} / Storage",content="Waiting for refresh",icon="externaldrive.fill",script-name=kiwivm-storage,update-interval={{{Update Interval}}} #!REQUIREMENT "'{{{Show Storage}}}' == 'true'"
KiwiVM Security = title="{{{Panel Title}}} / Security",content="Waiting for refresh",icon="lock.shield.fill",script-name=kiwivm-security,update-interval={{{Update Interval}}} #!REQUIREMENT "'{{{Show Security}}}' == 'true'"
KiwiVM Maintenance = title="{{{Panel Title}}} / Maintenance",content="Waiting for refresh",icon="wrench.and.screwdriver.fill",script-name=kiwivm-maintenance,update-interval={{{Update Interval}}} #!REQUIREMENT "'{{{Show Maintenance}}}' == 'true'"

[Script]
kiwivm-overview = type=generic,timeout=15,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/kiwivm-panel.js,argument="mode=overview&title={{{Panel Title}}}&icon={{{Panel Icon}}}&color={{{Panel Color}}}&veid={{{VEID}}}&api_key={{{API Key}}}" #!REQUIREMENT "'{{{Show Overview}}}' == 'true'"
kiwivm-live = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/kiwivm-panel.js,argument="mode=live&title={{{Panel Title}}}&color={{{Panel Color}}}&veid={{{VEID}}}&api_key={{{API Key}}}" #!REQUIREMENT "'{{{Show Live}}}' == 'true'"
kiwivm-network = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/kiwivm-panel.js,argument="mode=network&title={{{Panel Title}}}&color={{{Panel Color}}}&veid={{{VEID}}}&api_key={{{API Key}}}" #!REQUIREMENT "'{{{Show Network}}}' == 'true'"
kiwivm-storage = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/kiwivm-panel.js,argument="mode=storage&title={{{Panel Title}}}&color={{{Panel Color}}}&veid={{{VEID}}}&api_key={{{API Key}}}" #!REQUIREMENT "'{{{Show Storage}}}' == 'true'"
kiwivm-security = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/kiwivm-panel.js,argument="mode=security&title={{{Panel Title}}}&color={{{Panel Color}}}&veid={{{VEID}}}&api_key={{{API Key}}}" #!REQUIREMENT "'{{{Show Security}}}' == 'true'"
kiwivm-maintenance = type=generic,timeout=20,script-path=https://raw.githubusercontent.com/gogrhw/surge/refs/heads/main/Scripts/kiwivm-panel.js,argument="mode=maintenance&title={{{Panel Title}}}&color={{{Panel Color}}}&veid={{{VEID}}}&api_key={{{API Key}}}" #!REQUIREMENT "'{{{Show Maintenance}}}' == 'true'"
